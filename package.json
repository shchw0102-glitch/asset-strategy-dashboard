{
  "name": "asset-strategy-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node scripts/run.mjs",
    "android:prepare": "npm run build && node scripts/android-assets.mjs",
    "android:debug": "npm run android:prepare && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run android:prepare && cd android && ./gradlew bundleRelease",
    "android": "npm run android:debug"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
